# OperaAI Claims Intelligence - Environment Configuration

# === APPLICATION ===
NODE_ENV=development
PORT=3000

# === DATABASE ===
# Development: Use in-memory SQLite (default in demo)
# Production: Use MySQL
DATABASE_URL=sqlite://:memory:
# DATABASE_URL=mysql://operaai:operaai_secure_password@localhost:3306/operaai_claims

DB_HOST=localhost
DB_PORT=3306
DB_USER=operaai
DB_PASSWORD=operaai_secure_password
DB_NAME=operaai_claims
DB_ROOT_PASSWORD=rootpassword

# === AI & LLM PROVIDERS ===
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo
OPENAI_TEMPERATURE=0.7

# Alternative LLM Providers
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# === AWS S3 (For Document Storage) ===
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=operaai-claims-documents
AWS_S3_PRESIGNED_URL_EXPIRY=3600

# === SINGAPORE REGULATORY COMPLIANCE ===
# MAS Notice 120 - Audit Trail & SLA Settings
MAS_AUDIT_RETENTION_DAYS=2555  # 7 years
MAS_SLA_LODGEMENT_HOURS=24
MAS_SLA_ASSESSMENT_HOURS=48
MAS_SLA_DECISIONING_HOURS=72
MAS_SLA_PAYMENT_HOURS=5  # Working days

# MOH Schedule of Fees
MOH_FEE_UPDATE_FREQUENCY=quarterly
MOH_PRORATION_THRESHOLD_PERCENT=120

# CPF Medisave / MediShield Life Integration
MEDISAVE_API_ENDPOINT=https://api.cpf.gov.sg/medisave
MEDISHIELD_API_ENDPOINT=https://api.cpf.gov.sg/medishield

# PDPA - Personal Data Protection Act
PDPA_DATA_MINIMIZATION=true
PDPA_CONSENT_TRACKING=true
PDPA_RETENTION_DAYS=365

# === SECURITY ===
JWT_SECRET=your-secret-jwt-key-change-in-production
SESSION_SECRET=your-secret-session-key-change-in-production
CORS_ORIGIN=http://localhost:5173

# === LOGGING & MONITORING ===
LOG_LEVEL=info
ENABLE_AUDIT_LOGS=true
SENTRY_DSN=

# === DEMO MODE ===
# Set to true to run in demo mode with reset button visible
DEMO_MODE=true
DEMO_AUTO_RESET_MINUTES=30
